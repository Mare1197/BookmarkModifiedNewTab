{
  "name": "super-bookmark-desktop",
  "version": "1.5.2",
  "description": "A bookmark manager that acts like your computer desktop",
  "main": "build.js",
  "overrides": {
    "@blocksuite/icons": "2.1.75",
    "file-type": "22.1.1"
  },
  "dependencies": {
    "@blocksuite/block-std": "0.19.5",
    "@blocksuite/blocks": "0.19.5",
    "@blocksuite/presets": "0.19.5",
    "@blocksuite/store": "0.19.5",
    "@xyflow/react": "^12.10.1",
    "dexie": "^4.4.5",
    "lit": "3.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@wxt-dev/module-react": "^1.2.2",
    "clean-css": "4.2.3",
    "eslint": "^9.33.0",
    "fake-indexeddb": "^6.2.5",
    "ncp": "2.0.0",
    "rimraf": "2.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "uglify-es": "3.1.3",
    "wxt": "^0.21.4"
  },
  "scripts": {
    "build": "npm run prepare:wxt && wxt build && node scripts/finalize-wxt.js",
    "build:legacy": "node build.js",
    "build:wxt": "wxt build",
    "dev": "npm run prepare:wxt && wxt",
    "format:check": "node scripts/format-check.js",
    "lint": "eslint . --max-warnings=0 && npm run format:check",
    "postinstall": "wxt prepare",
    "prepare:wxt": "node scripts/prepare-wxt.js",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "node --test tests/*.test.js",
    "test:smoke": "playwright test tests/e2e",
    "typecheck": "wxt prepare && tsc --noEmit && tsc -p tsconfig.workspace.json",
    "zip": "npm run prepare:wxt && wxt zip && node scripts/finalize-wxt.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mare1197/BookmarkModifiedNewTab.git"
  },
  "keywords": [
    "super",
    "bookmark",
    "desktop",
    "chrome",
    "extension",
    "new",
    "tab",
    "page"
  ],
  "author": "Kyle Paulsen <kyle.a.paulsen@gmail.com> (http://www.kylepaulsen.com/)",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/Mare1197/BookmarkModifiedNewTab/issues"
  },
  "homepage": "https://github.com/Mare1197/BookmarkModifiedNewTab#readme"
}
