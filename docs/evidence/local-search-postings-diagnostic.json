  "diagnosticSource": "// Disposable synthetic IndexedDB experiment. Not application or acceptance code.\nconst {chromium} = require('@playwright/test');\nconst {workspaceFixture} = require('../../../tests/helpers/workspaceFixture');\nconst {makeSearchIndexFixture} = require('../../../tests/helpers/largeLibraryFixture');\n\n(async () => {\n    const cleanups = [], fixture = await workspaceFixture({after: callback => cleanups.push(callback)});\n    let browser;\n    try {\n        const {deriveSearchDocument} = fixture.load('searchGrams.ts');\n        const rows = makeSearchIndexFixture(10000, 'small-board').data.entities.map(entity => {\n            const row = deriveSearchDocument(entity, 1, 'diagnostic', 'en-US');\n            return {...row, grams: [...new Set([...row.explorerGrams, ...row.brainGrams, ...row.smartGrams])]};\n        });\n        console.log(JSON.stringify({stage: 'derived', rows: rows.length, postings: rows.reduce((n, r) => n + r.explorerGrams.length + r.brainGrams.length + r.smartGrams.length, 0),\n            unionPostings: rows.reduce((n, r) => n + r.grams.length, 0)}));\n        browser = await chromium.launchPersistentContext('', {channel: 'chromium', headless: true, timeout: 60000});\n        console.log(JSON.stringify({stage: 'launched'}));\n        const page = await browser.newPage();\n        await page.route('http://localhost:19876/**', route => route.fulfill({contentType: 'text/html', body: '<title>Synthetic search diagnostic</title>'}));\n        await page.goto('http://localhost:19876/');\n        await page.evaluate(rows => {window.diagnosticRows = rows;}, rows);\n        // Alternate modes so a late run is not always the optimized candidate.\n        for (const mode of ['dialect', 'union', 'none', 'union', 'dialect']) {\n            console.log(JSON.stringify({stage: 'start', mode}));\n            const result = await page.evaluate(async mode => {\n                const db = await new Promise((resolve, reject) => {\n                    const request = indexedDB.open('diagnostic-' + crypto.randomUUID(), 1);\n                    request.onupgradeneeded = () => {\n                        const store = request.result.createObjectStore('documents', {keyPath: 'id'});\n                        store.createIndex('epoch', 'epoch');\n                        store.createIndex('overflowDialects', 'overflowDialects', {multiEntry: true});\n                        for (const field of mode === 'dialect' ? ['explorerGrams', 'brainGrams', 'smartGrams'] : mode === 'union' ? ['grams'] : [])\n                            store.createIndex(field, field, {multiEntry: true});\n                    };\n                    request.onsuccess = () => resolve(request.result); request.onerror = () => reject(request.error);\n                });\n                const start = performance.now(), batches = [];\n                try {\n                    for (let offset = 0; offset < window.diagnosticRows.length; offset += 50) {\n                        const batchStart = performance.now();\n                        await new Promise((resolve, reject) => {\n                            const tx = db.transaction('documents', 'readwrite'), store = tx.objectStore('documents');\n                            for (const row of window.diagnosticRows.slice(offset, offset + 50)) store.put(row);\n                            tx.oncomplete = resolve; tx.onabort = () => reject(tx.error);\n                        });\n                        batches.push(performance.now() - batchStart);\n                    }\n                    return {mode, ms: performance.now() - start, batches};\n                } finally {db.close();}\n            }, mode);\n            console.log(JSON.stringify({stage: 'result', ...result}));\n        }\n    } catch (error) {console.error(error); process.exitCode = 1;} finally {\n        if (browser) await browser.close();\n        for (const cleanup of cleanups) await cleanup();\n    }\n})().catch(error => {console.error(error); process.exitCode = 1;});\n"
